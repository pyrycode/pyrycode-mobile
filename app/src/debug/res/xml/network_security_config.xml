<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only network security config for the interactive-stream e2e (#337 / #642 rung 3).

  Android blocks cleartext (non-TLS) traffic by default on this target SDK. The e2e points the app at
  a plaintext ws:// relay on the host (scripts/e2e-emulator.sh), reached from the emulator at the
  10.0.2.2 alias. This permits cleartext to the loopback/host addresses only. Release builds do NOT
  include this file (it lives in src/debug), so production continues to require TLS (wss://).
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">10.0.2.2</domain>
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
    </domain-config>
</network-security-config>
