<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay for the interactive-stream e2e (#337 / #642 rung 3). It points the app
  at a network security config that permits cleartext to the local relay (see
  res/xml/network_security_config.xml). Merged only into debug builds; release is unaffected.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
