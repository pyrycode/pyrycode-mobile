    <!--
      Launcher icon background under the glow: the dark scheme's surface
      (backgroundDark in ui/theme/Color.kt, Figma 703:5002). Launchers render
      outside the app process, so ?attr/... does not resolve here.
    -->
    <color name="ic_launcher_background">#FF101418</color>
    <!--
      Launch splash background: the dark scheme's background (backgroundDark in
      ui/theme/Color.kt, Figma 701:5001). The splash window is drawn before the
      app theme exists, so it cannot reference ?attr/... either.
    -->
    <color name="splash_background">#FF101418</color>
    <!--
      Launch splash mark fill: the brand glacier blue the launcher icon (#1546)
      uses, a literal brand colour rather than a scheme token (Figma 701:5001).
    -->
    <color name="splash_mark">#FF7AB8E8</color>
