local.properties

# CodeGraph index (used by dispatcher worktree symlink + interactive
# Claude Code sessions for symbol-level code intel — local cache only).
# No trailing slash: matches both directories AND symlinks. The trailing
# slash variant `.codegraph/` only matches directories, which let the
# dispatcher's worktree symlink at `<wt>/.codegraph` slip past gitignore
# and get auto-committed in pyrycode (commit 30f3d53). Same fix here
# defensively before the same chain bites this repo.
.codegraph
.dispatcher.lock

# Kotlin compiler-daemon session markers. Deleted and recreated on every
# build, so tracking one makes every worktree permanently dirty — and the
# dispatcher's unconditional safety-net commit would then re-commit that
# churn on every agent run, in every column. Same class as the .codegraph
# chain above, through a different door; no trailing slash for the same
# reason.
.kotlin

# IntelliJ / Android Studio project files
.idea/

# Python test harness bytecode
__pycache__/
